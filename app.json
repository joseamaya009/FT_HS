{
  "expo": {
    "name": "HidroSmart",
    "slug": "hidrosmart-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hidrosmart.app",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "HidroSmart utiliza Bluetooth para encontrar y configurar dispositivos de monitoreo de agua."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d7f0536c-7f9f-4ab1-a3f9-81cfa4d99388"
      }
    }
  }
}
