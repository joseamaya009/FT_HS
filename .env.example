VITE_API_URL=http://localhost:3000/api/v1
FRONTEND_PORT=5173
VITE_MQTT_DEVICE_HOST=hidrosmart-broker.local
VITE_MQTT_DEVICE_PORT=1883

# Mobile/Expo. El bundle se incluye en la aplicación y la API debe ser
# alcanzable por el teléfono: usa un dominio HTTPS o el nombre DNS de tu red.
# No uses localhost aquí, pues dentro del teléfono apunta al propio teléfono.
EXPO_PUBLIC_WEB_BASE_URL=https://app.hidrosmart.example/
EXPO_PUBLIC_API_URL=https://api.hidrosmart.example/api/v1

# Expo Go en Android detecta automáticamente la IP LAN del PC con
# `npm run mobile:start`. Si hay VPN o varios adaptadores, fuerza la IP así:
# MOBILE_LAN_HOST=192.168.1.100
